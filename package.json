{
  "name": "@haneoka/altair-plugin-workspace-browser",
  "version": "0.1.0",
  "description": "Cancellable browser folder, file-input, and workspace asset services for Altair",
  "keywords": [
    "altair",
    "visual-novel",
    "file-system-access",
    "workspace",
    "browser"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/altair-plugin-workspace-browser.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/altair-plugin-workspace-browser/issues"
  },
  "homepage": "https://github.com/haneoka-gakuen/altair-plugin-workspace-browser#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js",
      "default": "./dist/assets.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js",
      "default": "./dist/environment.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js",
      "default": "./dist/persistence.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "peerDependencies": {
    "@haneoka/altair": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/vega": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "prettier": "3.7.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "altair": {
    "pluginApi": 2,
    "kind": "service",
    "capabilities": [
      "assets",
      "services"
    ],
    "permissions": [
      "filesystem:read",
      "filesystem:write"
    ],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
